# coauthored-submit configuration. Copy to .env for local use; never commit real secrets.
# In production set these on the Cloud Run service and job (secrets via Secret Manager).

# --- Mode -------------------------------------------------------------------------------
FLASK_ENV=development            # production in Cloud Run (the default when unset)
SECRET_KEY=change-me             # production: 64+ random characters (Secret Manager)
# DEV_AUTH=1                     # trusts the X-Dev-User-Email header / dev sign-in form.
                                 # Refused at start-up unless FLASK_ENV=development or TESTING=1.

# --- Database (shared with coauthored-browse) ------------------------------------------
CLASSIC_DB_URI=sqlite:///instance/coauthored-dev.db
# Local MySQL (docker compose):
# CLASSIC_DB_URI=mysql+pymysql://coauthored:coauthored-dev@127.0.0.1:3307/coauthored?charset=utf8mb4
# Cloud SQL from Cloud Run (unix socket mounted by --add-cloudsql-instances):
# CLASSIC_DB_URI=mysql+pymysql://submit:PASSWORD@/coauthored?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE&charset=utf8mb4

# --- Object store (the root browse reads; = DISSEMINATION/SOURCE_STORAGE_PREFIX) ---------
STORAGE_PREFIX=./local-store     # production: gs://BUCKET (the bucket root)
PDF_MAX_BYTES=52428800           # 50 MB policy maximum. Cloud Run: 31457280 (30 MB), see README.

# --- Policy ------------------------------------------------------------------------------
SUBMISSIONS_PER_DAY=5
MAX_CROSS_LISTS=4
LICENSE_HOST=aicoauthored.dev      # host of Coauthored's non-exclusive licence URI

# --- Links -------------------------------------------------------------------------------
BROWSE_BASE_URL=https://aicoauthored.dev        # published papers: {BROWSE_BASE_URL}/abs/<id>
HELP_BASE_URL=https://aicoauthored.dev
SOURCE_URL=https://github.com/coauthoredai/coauthored-submit

# --- Clerk (production auth) -------------------------------------------------------------
CLERK_JWKS_URL=https://clerk.aicoauthored.dev/.well-known/jwks.json
CLERK_ISSUER=https://clerk.aicoauthored.dev
CLERK_AUTHORIZED_PARTIES=https://submit.aicoauthored.dev
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_FRONTEND_API_URL=https://clerk.aicoauthored.dev
CLERK_SIGN_IN_URL=https://accounts.aicoauthored.dev/sign-in
CLERK_SIGN_UP_URL=https://accounts.aicoauthored.dev/sign-up
# CLERK_SIGN_OUT_URL=           # optional; otherwise /sign-out signs out with Clerk's script
# CLERK_SECRET_KEY=sk_live_...  # only if the session token lacks email/name claims (Secret Manager)

# --- Mail ----------------------------------------------------------------------------------
MAILER=log                       # smtp in production; capture is for tests only
MAIL_FROM="Coauthored <no-reply@aicoauthored.dev>"
SMTP_HOST=
SMTP_PORT=587                    # 465 = implicit TLS; Cloud Run blocks port 25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
